{
  "name": "foxl-browser-extension",
  "private": true,
  "description": "Foxl browser extension - lets the Foxl agent act in your real Chrome tabs",
  "homepage": "https://github.com/foxl-ai/browser-extension",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:browser": "node --test --test-concurrency=1 scripts/browser/*.test.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "playwright": "1.64.1",
    "ws": "8.21.0"
  },
  "engines": {
    "node": ">=20"
  }
}
